Proceso Onestyle_Mariana
		Definir primer_nombre, primer_apellido Como Caracter;
		Definir id_prenda, stock_disponible, cantidad_deseada Como Entero;
		
		Escribir "Ingrese su primer nombre y primer apellido:";
		Leer primer_nombre, primer_apellido;
		
		Escribir "Ingrese el ID de la prenda seleccionada y la cantidad deseada:";
		Leer id_prenda, cantidad_deseada;
		
		stock_disponible <- 5 ;
		
		Si cantidad_deseada <= stock_disponible Entonces
			stock_disponible <- stock_disponible - cantidad_deseada;
			Escribir "¡Reserva exitosa, ", primer_nombre, " ", primer_apellido, "!";
			Escribir "Tu pedido está en estado: Pendiente de Pago.";
			Escribir "Generando enlace parametrizado de WhatsApp...";
		Sino
			Escribir "Lo sentimos, ", primer_nombre, ". No hay stock suficiente.";
			Escribir "Stock actual para esta talla/prenda: ", stock_disponible;
		FinSi
FinAlgoritmo
